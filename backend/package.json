{
  "name": "woodflow-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "npm run migrate && ts-node-dev --respawn src/server.ts",
    "migrate": "ts-node src/migrate.ts",
    "seed": "ts-node src/seed.ts",
    "seed:massive": "ts-node src/seed-massive.ts",
    "db:reset": "ts-node src/reset.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.9.7",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.3",
    "umzug": "^3.8.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.7",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
